erDiagram

    USER_TYPE ||--o{ USER_INFO : "has"
    USER_INFO ||--o{ RESERVATION : "makes"
    HOTEL ||--o{ RESERVATION : "has"
    RESERVATION ||--|| PAYMENT : "has"

    USER_TYPE {
        int user_type_number PK
        string user_type
    }

    USER_INFO {
        int user_number PK
        string user_name
        int user_type_number FK
    }

    RESERVATION {
        int reservation_number PK
        int user_number FK
        date check_in_date
        date check_out_date
        int payment_number FK
        int hotel_number FK
        string reservation_status
        int number_of_guests
        datetime reservation_datetime
    }

    PAYMENT {
        int payment_number PK
        string payment_type
        string payment_status
        datetime payment_datetime
        int payment_amount
    }

    HOTEL {
        int hotel_number PK
        string hotel_name
    }
